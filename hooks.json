{
  "jev-harness": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook_entry.mjs PreInvocation",
        "timeout": 6
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook_entry.mjs PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook_entry.mjs PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook_entry.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
